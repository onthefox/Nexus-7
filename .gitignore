```gitignore
# Python compiled files
*.pyc
__pycache__/

# Audit logs
audit-*/audit-log.json

# Environment files
.env
.env.local
*.env.*

# Dependencies
.venv/
venv/
node_modules/

# Logs and temporary files
*.log
*.tmp
*.swp

# Editors
.vscode/
.idea/

# Build artifacts
dist/
build/
target/

# Testing
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
```