# Environment Configuration for Nexus-7 CTF-OS Ecosystem
# Copy this file to .env and customize as needed

# Application Settings
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000

# Database Configuration (optional - defaults to in-memory)
# DATABASE_URL=sqlite:///nexus7.db
# DATABASE_URL=postgresql://user:password@localhost:5432/nexus7

# Redis Configuration (optional - for caching and event bus)
# REDIS_URL=redis://localhost:6379/0

# Security Settings
SECRET_KEY=your-secret-key-change-in-production
JWT_EXPIRY_HOURS=24

# API Keys (for external integrations)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Shannon Pentest Agent Settings
SHANNON_ENABLED=true
SHANNON_MAX_CONCURRENT_ATTACKS=5

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_BURST=10

# Token Budget Settings
DEFAULT_TOKEN_BUDGET=10000
MAX_TOKEN_BUDGET=100000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Docker Settings
DOCKER_SANDBOX_ENABLED=true
DOCKER_NETWORK=nexus7-network

# CTF Settings
CTF_DEFAULT_MATCH_DURATION_HOURS=24
CTF_FLAG_PREFIX=nexus7
CTF_MIN_POINTS=10
CTF_MAX_POINTS=1000

# Alignment Guard Settings
ALIGNMENT_CIRCUIT_BREAKER_THRESHOLD=3
ALIGNMENT_AUTO_SHUTDOWN=true

# Ledger Settings
LEDGER_PERSISTENCE_ENABLED=true
LEDGER_BACKUP_INTERVAL_HOURS=1
